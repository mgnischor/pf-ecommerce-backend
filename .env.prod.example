# Non-secret settings for docker-compose-prod.yml. Copy to .env.prod (untracked) and edit.
#
# Pass it explicitly so the development .env is never read by the production stack:
#     docker compose --env-file .env.prod -f docker-compose-prod.yml up -d --build
#
# Secrets are NOT set here: they are files under ./secrets (bash scripts/init-secrets.sh prod --admin-email ...).

# The images are built on this host (`docker compose ... up -d --build`) and tagged pf-ecommerce-api:local and
# pf-ecommerce-migrations:local. Set the two variables below only to deploy images from a registry, each pinned to
# version AND digest (never "latest"); the placeholder digests do not resolve, so leave them commented until real.
# API_IMAGE=registry.example.com/ecommerce-api:1.0.0@sha256:replace-with-the-image-digest
# MIGRATIONS_IMAGE=registry.example.com/ecommerce-migrations:1.0.0@sha256:replace-with-the-image-digest
API_VERSION=1.0.0

# Public host name(s) the API answers to, separated by ";" (anything else is rejected with 400). Do not add
# "localhost": docker-compose-prod.yml appends it, because the container healthcheck calls http://localhost:8080.
API_ALLOWED_HOSTS=api.example.com

# Public https URL of the API: the "iss" claim of every access token.
JWT_ISSUER=https://api.example.com
# JWT_ACTIVE_KEY_ID=key-1

# Where the reverse proxy reaches the API and Grafana (loopback by default; never publish these directly).
# API_BIND_ADDRESS=127.0.0.1
# API_PORT=8080
# GRAFANA_PORT=3000
