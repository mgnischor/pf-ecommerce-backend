# Keep the build context small and free of secrets (ai/CONTAINERS.md §2.4).

# Version control and tooling
.git
.gitattributes
.gitignore
.github
.claude
.vs
.vscode
.idea
workspace

# Secrets and local configuration
.env
.env.*
!.env.example
!.env.prod.example
secrets
*.pem
*.key
*.pfx
*.p12
appsettings.*.local.json
*.user
# The patterns above only match at the context root; these catch the same files anywhere in the tree.
**/.env
**/secrets
**/*.pem
**/*.key
**/*.pfx
**/*.p12

# Build output and test results
**/bin
**/obj
TestResults
tests
coverage

# Documentation and standards
ai
docs
*.md
Portfolio.http

# Infrastructure, orchestration, and operations files are not part of the image
infrastructure
kubernetes
observability
scripts/*
!scripts/build-migrations-bundles.sh
database
Dockerfile
.dockerignore
docker-compose*.yml
