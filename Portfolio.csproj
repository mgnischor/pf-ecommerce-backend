<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Portfolio</RootNamespace>
    <!-- Test projects live under tests/ and must not be compiled into the application. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**;infrastructure/**;kubernetes/**;docs/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sanctioned exception to "no production changes for testability" (ai/TESTS.md §2.3). -->
    <InternalsVisibleTo Include="Portfolio.UnitTests" />
    <InternalsVisibleTo Include="Portfolio.ArchitectureTests" />
    <InternalsVisibleTo Include="Portfolio.IntegrationTests" />
  </ItemGroup>
</Project>
