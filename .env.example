# Development credentials for docker-compose-dev.yml.
#
# Copy to .env (untracked, see .gitignore) and replace every value, or generate one with random values:
#     bash scripts/init-secrets.sh dev          (Linux, macOS, Git Bash, WSL)
#     pwsh scripts/init-secrets.ps1 -Mode dev   (Windows PowerShell 7)
#
# These are development-only credentials for containers bound to 127.0.0.1. Production never reads this
# file: docker-compose-prod.yml takes its secrets from files under ./secrets (ai/SECURITY.md §5).

# Backing services
POSTGRES_PASSWORD=change-me-postgres
VALKEY_PASSWORD=change-me-valkey
RABBITMQ_PASSWORD=change-me-rabbitmq

# Account created at startup so you can sign in (a developer-level account; the password must be at least
# 12 characters, not common, and must not contain the e-mail name).
DEV_ACCOUNT_EMAIL=dev.account@example.com
DEV_ACCOUNT_PASSWORD=change-me-to-a-long-random-passphrase

# Optional overrides
# Published host ports (all bound to 127.0.0.1). Change one when it clashes with something already running.
# API_PORT=8080
# POSTGRES_PORT=5432
# VALKEY_PORT=6379
# RABBITMQ_PORT=5672
# RABBITMQ_MANAGEMENT_PORT=15672
# GRAFANA_PORT=3000
# OTLP_GRPC_PORT=4317
# OTLP_HTTP_PORT=4318
