{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:ecommerce:events:shipping.shipment-failed:v1",
    "title": "shipping.shipment-failed v1",
    "description": "A delivery failed or the shipment was returned. Consumers must ignore properties they do not know: adding one is a backward-compatible change.",
    "type": "object",
    "required": ["eventId", "aggregateId", "aggregateVersion", "occurredAt", "orderId", "reasonCode"],
    "properties": {
        "eventId": {
            "type": "string",
            "format": "uuid",
            "description": "Unique per occurrence; the message-id consumers deduplicate on."
        },
        "aggregateId": {
            "type": "string",
            "format": "uuid",
            "description": "The shipment."
        },
        "aggregateVersion": {
            "type": "integer",
            "minimum": 1,
            "description": "Version of the aggregate after the change; detects gaps and reordering."
        },
        "occurredAt": {
            "type": "string",
            "format": "date-time",
            "description": "UTC."
        },
        "orderId": {
            "type": "string",
            "format": "uuid",
            "description": "The order the shipment fulfills."
        },
        "reasonCode": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{1,31}$",
            "description": "Machine-readable reason."
        }
    }
}
