{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:ecommerce:events:catalog.product-status-changed:v1",
    "title": "catalog.product-status-changed v1",
    "description": "A product's lifecycle status changed. Consumers must ignore properties they do not know: adding one is a backward-compatible change.",
    "type": "object",
    "required": ["eventId", "aggregateId", "aggregateVersion", "occurredAt", "from", "to"],
    "properties": {
        "eventId": {
            "type": "string",
            "format": "uuid",
            "description": "Unique per occurrence; the message-id consumers deduplicate on."
        },
        "aggregateId": {
            "type": "string",
            "format": "uuid"
        },
        "aggregateVersion": {
            "type": "integer",
            "minimum": 1,
            "description": "Version of the aggregate after the change; detects gaps and reordering."
        },
        "occurredAt": {
            "type": "string",
            "format": "date-time",
            "description": "UTC."
        },
        "from": {
            "enum": ["draft", "active", "discontinued"]
        },
        "to": {
            "enum": ["draft", "active", "discontinued"]
        }
    }
}
